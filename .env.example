# Model endpoint. Copy this file to .env yourself; never commit .env or paste keys into chat.
# On SuperGrid the runtime supplies FLWR_RUNTIME_BASE_URL / FLWR_RUNTIME_API_KEY automatically
# and only AGENT_MODEL is needed there.
SPONSOR_API_KEY=
# Nebius Token Factory (Responses API). Key is shared in Slack #hackathon_stanford_2026.
SPONSOR_BASE_URL=https://api.tokenfactory.tf-ca1.nebius.com/v1/
# Model string. For Endeavor 1.0 use the identifier Flower publishes (not yet confirmed).
# Nebius IDs from the event post: dedicated/flowerai/Kimi-K2.7-Code-1OUHWL, dedicated/flowerai/MiniMax-M3-OOLI9o
AGENT_MODEL=
